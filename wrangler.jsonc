// Cloudflare static assets, assets only, no Worker script (ADR-0014, MOD-Build). Copied from the
// sibling image-annotator. Used only by the owner by hand in phase 7; nothing is provisioned before
// then, wrangler (DEP-31) is installed only then, and nothing here is a secret. The account comes
// from the CLOUDFLARE_ACCOUNT_ID environment variable.
// Headers: dist/_headers (generated by `pnpm gen`). Not uploaded: dist/.assetsignore (*.map, .vite).
// Staging (`clip-maker-staging.tarokit.app`, D-036) is added as a second environment in phase 7.
{
  "name": "clip-maker",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths answer a plain 404 (a single-page tool with no client routes).
    "not_found_handling": "none",
  },
  // Only the custom domain serves the tool: no *.workers.dev address, no preview URLs (ADR-0014).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "clip-maker.tarokit.app", "custom_domain": true }],
  // Staging (D-036), selected with `--env staging`. Written in the release phase, NOT applied; the
  // owner runs it in phase 7. A second Worker name so production is never touched. Build staging with
  // TOOL_ORIGIN=https://clip-maker-staging.tarokit.app (see docs/deploy/runbook.md).
  "env": {
    "staging": {
      "name": "clip-maker-staging",
      "assets": { "directory": "./dist", "not_found_handling": "none" },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "clip-maker-staging.tarokit.app", "custom_domain": true }],
    },
  },
}
