# Every variable Clip Maker's scripts read (ADR-0014). No value here is a secret. The scripts read them
# from the environment (e.g. `HOST_ORIGINS=… pnpm build`), not from a file; if you keep a local .env to
# source in your shell, it is git-ignored. Only the LOCAL environment is filled in; staging and
# production values are set in phase 7 (nothing is provisioned before then).

# Build time (MOD-Build): space-separated origins allowed to embed the tool. It sets the CSP
# frame-ancestors in public/_headers and the runtime message allow-list (RULE-17, NFR-09).
# Default when unset: https://tarokit.app. Empty value = standalone only. Wildcards are refused;
# http is accepted only for localhost / 127.0.0.1 (a local stub host), e.g.:
#   HOST_ORIGINS="https://tarokit.app http://localhost:4290"
HOST_ORIGINS="https://tarokit.app"

# Build time (MOD-Build): the tool's own origin, sent as Access-Control-Allow-Origin on the worker
# and worklet modules (ADR-0014 outcome: iOS Safari refuses the same-origin worklet over CORS
# otherwise). Default when unset: https://clip-maker.tarokit.app (A3).
TOOL_ORIGIN="https://clip-maker.tarokit.app"

# Test time (optional): the port `pnpm test:e2e` previews dist/ on. Default: per-checkout 30000–31999.
E2E_PORT=

# Phase 7 only — leave empty during development (nothing is provisioned before then, ADR-0014).
CLOUDFLARE_ACCOUNT_ID=
# Secret: never put a real value in a file. Set it in your shell when phase 7 needs it.
CLOUDFLARE_API_TOKEN=
