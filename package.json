{
  "name": "clip-maker",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A light, local-only video editor in the TaroKit media tools: clips, text, music, looks and watermark-free MP4/GIF/audio export. Nothing leaves the device.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium webkit && pnpm gen",
    "reset": "node scripts/reset.mjs",
    "gen": "node scripts/gen-all.mjs",
    "gen:check": "node scripts/gen-all.mjs --check",
    "dev": "pnpm gen && vite",
    "build": "pnpm gen && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs --strict",
    "check:release": "node scripts/check-licenses.mjs --strict --release",
    "check:size": "node scripts/check-size.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check.mjs --no-e2e",
    "check:realtime": "playwright test --project=chromium-realtime --project=webkit-realtime --no-deps --workers=1",
    "spec:lint": "python3 tools/spec_lint.py",
    "release:build": "bash scripts/release-build.sh"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@preact/signals": "2.11.2",
    "gifenc": "1.0.3",
    "lucide-static": "1.55.0",
    "mediabunny": "1.65.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "style-dictionary": "5.5.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
