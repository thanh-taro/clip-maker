{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clip-maker/project.schema.json",
  "title": "ENT-Project (in-memory only, never stored between sessions)",
  "description": "Times are integer microseconds. Ranges and defaults are defined in specs/10-domain/rules.md.",
  "type": "object",
  "required": [
    "frame",
    "sources",
    "clips",
    "textLayers",
    "audioClips"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "us": {
      "type": "integer",
      "minimum": 0
    },
    "volume": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
      "description": "RULE-12, percent"
    },
    "paletteColour": {
      "enum": [
        "white",
        "black",
        "red",
        "orange",
        "yellow",
        "green",
        "cyan",
        "blue",
        "purple",
        "pink"
      ],
      "description": "RULE-11"
    },
    "placement": {
      "type": "object",
      "description": "RULE-07",
      "required": [
        "mode",
        "scale",
        "offsetX",
        "offsetY",
        "rotation",
        "flipH",
        "flipV"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "fit",
            "fill"
          ]
        },
        "scale": {
          "type": "integer",
          "minimum": 50,
          "maximum": 400
        },
        "offsetX": {
          "type": "number",
          "description": "fraction of frame width"
        },
        "offsetY": {
          "type": "number",
          "description": "fraction of frame height"
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "flipH": {
          "type": "boolean"
        },
        "flipV": {
          "type": "boolean"
        }
      }
    },
    "adjustments": {
      "type": "object",
      "description": "RULE-08",
      "additionalProperties": false,
      "properties": {
        "brightness": {
          "$ref": "#/$defs/bipolar"
        },
        "contrast": {
          "$ref": "#/$defs/bipolar"
        },
        "highlights": {
          "$ref": "#/$defs/bipolar"
        },
        "shadows": {
          "$ref": "#/$defs/bipolar"
        },
        "saturation": {
          "$ref": "#/$defs/bipolar"
        },
        "vibrance": {
          "$ref": "#/$defs/bipolar"
        },
        "temperature": {
          "$ref": "#/$defs/bipolar"
        },
        "tint": {
          "$ref": "#/$defs/bipolar"
        },
        "sharpen": {
          "$ref": "#/$defs/unipolar"
        },
        "vignette": {
          "$ref": "#/$defs/unipolar"
        },
        "grain": {
          "$ref": "#/$defs/unipolar"
        },
        "fade": {
          "$ref": "#/$defs/unipolar"
        }
      }
    },
    "bipolar": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "unipolar": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "look": {
      "type": [
        "object",
        "null"
      ],
      "description": "RULE-09; null = None",
      "required": [
        "id",
        "intensity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "intensity": {
          "$ref": "#/$defs/unipolar"
        }
      }
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$",
      "description": "sRGB colour, upper-case #RRGGBB"
    },
    "colourRange": {
      "enum": [
        "red",
        "orange",
        "yellow",
        "green",
        "aqua",
        "blue",
        "purple",
        "magenta"
      ],
      "description": "RULE-24 colour ranges"
    },
    "mixerRange": {
      "type": "object",
      "additionalProperties": false,
      "description": "RULE-24 Colour mixer, one range; absent values are 0",
      "properties": {
        "hue": {
          "$ref": "#/$defs/bipolar"
        },
        "saturation": {
          "$ref": "#/$defs/bipolar"
        },
        "lightness": {
          "$ref": "#/$defs/bipolar"
        }
      }
    },
    "hueDegrees": {
      "type": "integer",
      "minimum": 0,
      "maximum": 359
    },
    "colourTools": {
      "type": "object",
      "additionalProperties": false,
      "description": "RULE-24, RULE-25 (D-053). Optional on a clip; every absent part is at its default, so a clip without it is unchanged.",
      "properties": {
        "mixer": {
          "type": "object",
          "additionalProperties": false,
          "description": "RULE-24 Colour mixer; absent ranges are all 0",
          "properties": {
            "red": {
              "$ref": "#/$defs/mixerRange"
            },
            "orange": {
              "$ref": "#/$defs/mixerRange"
            },
            "yellow": {
              "$ref": "#/$defs/mixerRange"
            },
            "green": {
              "$ref": "#/$defs/mixerRange"
            },
            "aqua": {
              "$ref": "#/$defs/mixerRange"
            },
            "blue": {
              "$ref": "#/$defs/mixerRange"
            },
            "purple": {
              "$ref": "#/$defs/mixerRange"
            },
            "magenta": {
              "$ref": "#/$defs/mixerRange"
            }
          }
        },
        "pop": {
          "type": "object",
          "additionalProperties": false,
          "description": "RULE-24 Colour pop; colour null = None (default)",
          "properties": {
            "colour": {
              "anyOf": [
                {
                  "$ref": "#/$defs/colourRange"
                },
                {
                  "type": "null"
                }
              ]
            },
            "range": {
              "$ref": "#/$defs/unipolar",
              "default": 50
            },
            "amount": {
              "$ref": "#/$defs/unipolar",
              "default": 100
            }
          }
        },
        "splitToning": {
          "type": "object",
          "additionalProperties": false,
          "description": "RULE-24 Split toning",
          "properties": {
            "shadowsHue": {
              "$ref": "#/$defs/hueDegrees",
              "default": 210
            },
            "shadowsStrength": {
              "$ref": "#/$defs/unipolar",
              "default": 0
            },
            "highlightsHue": {
              "$ref": "#/$defs/hueDegrees",
              "default": 35
            },
            "highlightsStrength": {
              "$ref": "#/$defs/unipolar",
              "default": 0
            },
            "balance": {
              "$ref": "#/$defs/bipolar",
              "default": 0
            }
          }
        },
        "duotone": {
          "type": [
            "object",
            "null"
          ],
          "description": "RULE-24 Duotone; null or absent = None and never set on this clip. The object is kept while off (on: false) so Custom can start from the last colours. For a built-in pair, shadows and highlights are that pair's colours (looks.md).",
          "required": [
            "on",
            "pair",
            "shadows",
            "highlights",
            "strength"
          ],
          "additionalProperties": false,
          "properties": {
            "on": {
              "type": "boolean"
            },
            "pair": {
              "enum": [
                "midnight-peach",
                "plum-gold",
                "teal-cream",
                "indigo-pink",
                "forest-lime",
                "ink-coral",
                "custom"
              ]
            },
            "shadows": {
              "$ref": "#/$defs/hex"
            },
            "highlights": {
              "$ref": "#/$defs/hex"
            },
            "strength": {
              "$ref": "#/$defs/unipolar"
            }
          }
        },
        "replace": {
          "type": "array",
          "maxItems": 3,
          "description": "RULE-25 Colour replace, in list order",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "range",
              "softness"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/hex"
              },
              "to": {
                "$ref": "#/$defs/hex"
              },
              "range": {
                "$ref": "#/$defs/unipolar"
              },
              "softness": {
                "$ref": "#/$defs/unipolar"
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "frame": {
      "type": "object",
      "description": "RULE-04",
      "required": [
        "aspect",
        "frameRate",
        "background"
      ],
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "enum": [
            "9:16",
            "1:1",
            "4:5",
            "16:9",
            "original"
          ]
        },
        "frameRate": {
          "enum": [
            24,
            25,
            30,
            60
          ]
        },
        "frameRateChosen": {
          "type": "boolean"
        },
        "background": {
          "oneOf": [
            {
              "$ref": "#/$defs/paletteColour"
            },
            {
              "const": "blur"
            }
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "description": "ENT-Source",
        "required": [
          "id",
          "kind",
          "name",
          "bytes"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "video",
              "photo",
              "audio"
            ]
          },
          "name": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4000000000
          },
          "duration": {
            "$ref": "#/$defs/us"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "frameRate": {
            "type": "number"
          },
          "hasSound": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "clips": {
      "type": "array",
      "description": "Main track in order (INV-03)",
      "items": {
        "type": "object",
        "description": "ENT-Clip",
        "required": [
          "id",
          "sourceId",
          "kind",
          "placement",
          "adjustments",
          "look",
          "fadeIn",
          "fadeOut",
          "crossFadeNext"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "sourceId": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "video",
              "photo"
            ]
          },
          "in": {
            "$ref": "#/$defs/us",
            "description": "source time (not snapped to the project frame grid)"
          },
          "out": {
            "$ref": "#/$defs/us",
            "description": "source time (not snapped to the project frame grid)"
          },
          "duration": {
            "$ref": "#/$defs/us",
            "description": "photo only"
          },
          "volume": {
            "$ref": "#/$defs/volume"
          },
          "muted": {
            "type": "boolean"
          },
          "placement": {
            "$ref": "#/$defs/placement"
          },
          "adjustments": {
            "$ref": "#/$defs/adjustments"
          },
          "colourTools": {
            "$ref": "#/$defs/colourTools"
          },
          "look": {
            "$ref": "#/$defs/look"
          },
          "fadeIn": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3000000
          },
          "fadeOut": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3000000
          },
          "crossFadeNext": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000
          },
          "speedPct": {
            "type": "integer",
            "minimum": 25,
            "maximum": 400,
            "multipleOf": 5,
            "description": "RULE-06 speed × 100"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "video"
                }
              }
            },
            "then": {
              "required": [
                "in",
                "out",
                "speedPct",
                "volume",
                "muted"
              ],
              "not": {
                "required": [
                  "duration"
                ]
              }
            },
            "else": {
              "required": [
                "duration"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "in"
                    ]
                  },
                  {
                    "required": [
                      "out"
                    ]
                  },
                  {
                    "required": [
                      "speedPct"
                    ]
                  },
                  {
                    "required": [
                      "volume"
                    ]
                  },
                  {
                    "required": [
                      "muted"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "textLayers": {
      "type": "array",
      "maxItems": 50,
      "description": "Stacking order: later on top",
      "items": {
        "type": "object",
        "description": "ENT-TextLayer",
        "required": [
          "id",
          "content",
          "start",
          "end",
          "typeface",
          "size",
          "colour",
          "style",
          "align",
          "x",
          "y",
          "fade"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "content": {
            "type": "string",
            "description": "≤ 500 user-perceived characters, NFC (RULE-11)"
          },
          "start": {
            "$ref": "#/$defs/us"
          },
          "end": {
            "$ref": "#/$defs/us"
          },
          "typeface": {
            "enum": [
              "sans",
              "display",
              "serif",
              "rounded"
            ]
          },
          "size": {
            "type": "number",
            "minimum": 2,
            "maximum": 20,
            "description": "% of the frame's shorter side"
          },
          "colour": {
            "$ref": "#/$defs/paletteColour"
          },
          "style": {
            "enum": [
              "plain",
              "outline",
              "shadow",
              "box"
            ]
          },
          "boxColour": {
            "$ref": "#/$defs/paletteColour"
          },
          "align": {
            "enum": [
              "left",
              "centre",
              "right"
            ]
          },
          "x": {
            "type": "number",
            "description": "block centre, fraction of frame width from the left (RULE-11), default 0.5"
          },
          "y": {
            "type": "number",
            "description": "block centre, fraction of frame height from the top (RULE-11), default 0.8"
          },
          "fade": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "audioClips": {
      "type": "array",
      "description": "Never overlapping (INV-06)",
      "items": {
        "type": "object",
        "description": "ENT-AudioClip",
        "required": [
          "id",
          "sourceId",
          "start",
          "in",
          "out",
          "volume",
          "muted",
          "fadeIn",
          "fadeOut"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "sourceId": {
            "$ref": "#/$defs/id",
            "description": "an ENT-Source id"
          },
          "start": {
            "$ref": "#/$defs/us"
          },
          "in": {
            "$ref": "#/$defs/us"
          },
          "out": {
            "$ref": "#/$defs/us"
          },
          "volume": {
            "$ref": "#/$defs/volume"
          },
          "muted": {
            "type": "boolean"
          },
          "fadeIn": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000000
          },
          "fadeOut": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000000
          }
        },
        "additionalProperties": false
      }
    }
  }
}
